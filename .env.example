# Copy this to .env.local only if you need one of these. Vite loads .env.local
# automatically, and it's gitignored.

# Leave empty in the normal setup: in production the backend serves the
# website, and in development Vite forwards /api to it. Set this to the
# backend's https:// URL only when the website is hosted on a different domain.
VITE_API_URL=

# Optional. The backend already gives the page its Google client ID through
# /api/health; set this only to override that at build time.
VITE_GOOGLE_CLIENT_ID=
