# Copy this to .env.local (Vite loads .env.local automatically, and it's
# gitignored so your client ID doesn't end up in git).

# The backend from /server — see server/.env.example for its own setup.
VITE_API_URL=http://localhost:8787

# Same Google Cloud OAuth client ID you put in server/.env — the frontend
# uses it to render the button and request a token; the backend uses it to
# verify that token really was issued for this app.
VITE_GOOGLE_CLIENT_ID=
