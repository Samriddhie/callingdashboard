PORT=8787

# Only needed when the website is hosted on a different domain from this
# backend (for example the site on Netlify). Set it to that site's exact URL.
# When the backend serves the website itself, leave the default.
ALLOWED_ORIGIN=http://localhost:5173

# --- Sign-in and sessions ------------------------------------------------
# Set NODE_ENV=production on any deployed server. In production the server
# refuses to start unless SESSION_SECRET, GOOGLE_CLIENT_ID and
# ALLOWED_EMAIL_DOMAIN are all set.
NODE_ENV=
# Signs the session cookie. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
# Set to "none" only when the website and backend are on different domains.
# Needs HTTPS on both.
COOKIE_SAMESITE=
# Local development only: sign in with just a name, no Google needed.
# Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=

# Google Cloud Console → APIs & Services → Credentials → Create Credentials →
# OAuth client ID → Application type: Web application.
# Authorized JavaScript origin: http://localhost:5173 (add your production
# URL too once you deploy). No client secret needed for this flow.
GOOGLE_CLIENT_ID=

# Only Google accounts on this domain are allowed to sign in. Leave blank to
# allow any Google account (not recommended).
ALLOWED_EMAIL_DOMAIN=truehunt.store

# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Shopify -------------------------------------------------------------
# The store handle from your Shopify admin URL: admin.shopify.com/store/<this>.
# Without it the app can't build a link to a customer in Shopify.
SHOPIFY_STORE=

# --- CRM database (the Shopify sync) --------------------------------------
# Read-only. Leave CRM_DATABASE blank to disable the /api/crm/* endpoints.
CRM_DATABASE=truehunt_crm
CRM_HOST=localhost
CRM_PORT=5432
CRM_USER=samriddhisinha
# CRM_PASSWORD=            # not needed for a local trust/peer connection
# CRM_DATABASE_URL=postgres://user:pass@host:5432/dbname   # overrides the above
